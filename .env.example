# Copy to .env and fill in.

# ── Required from Week 2 ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Path to the dbt warehouse project root. Defaults to the bundled NordLedger
# simulation, which runs locally on DuckDB with no credentials.
DBT_PROJECT_DIR=./warehouse

# ── Planner + model routing (Q16) ─────────────────────────────────────────
PLANNER_MODEL=claude-sonnet-4-6
NEGOTIATION_OPUS_MODEL=claude-opus-4-7
# Opus takes over when: (a) Negotiation round >= NEGOTIATION_OPUS_ROUND,
# (b) Intake confidence < INTAKE_OPUS_CONFIDENCE_THRESHOLD.
NEGOTIATION_OPUS_ROUND=2
INTAKE_OPUS_CONFIDENCE_THRESHOLD=0.5

# ── Matching (Q6) ─────────────────────────────────────────────────────────
MATCHING_TOP_K=3

# ── Negotiation (Q7) ──────────────────────────────────────────────────────
MAX_NEGOTIATION_ROUNDS=3
MAX_CANDIDATES=3
PARTNER_RESPONSE_SLA_HOURS=24

# ── Monitor (Q8, Q9, Q10, Q11, Q12) ───────────────────────────────────────
POST_BOOKING_ACCEPT_SLA_HOURS=48
POST_BOOKING_CLOSE_SLA_DAYS=30
CHURN_RISK_THRESHOLD=65
CHURN_RISK_SUSTAINED_DAYS=7
SATURATED_UTIL_PCT=90
SATURATED_CONSECUTIVE_DAYS=7
STARVED_UTIL_PCT=20
STARVED_CONSECUTIVE_DAYS=14
MONITOR_SWEEP_HOUR_CET=6
WEEKLY_REPORT_DAY=monday
WEEKLY_REPORT_HOUR_CET=8

# ── HITL (Q13, Q14) ───────────────────────────────────────────────────────
HITL_TIMEOUT_BUSINESS_HOURS=4

# ── Cost budget (Q15) ─────────────────────────────────────────────────────
PER_LEAD_BUDGET_USD=2.0
BUDGET_CIRCUIT_BREAK_PCT=0.8

# ── As-of date (matches Self-Querying BI Agent pattern) ───────────────────
# Pin to an ISO date when running against the bounded simulation (NordLedger
# ends 2024-12); leave empty to use today's date in production.
AS_OF_DATE=2024-12-31
